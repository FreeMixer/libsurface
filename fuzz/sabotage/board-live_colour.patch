Breaks the check of fuzz/fuzz_board.c:370 (s->ncolour = n; -> s->ncolour = n ? n - 1 : 0;).
Caught by the seed input "colours" of fuzz_board.

diff --git a/src/surface.c b/src/surface.c
index 81d7b56..005072b 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -431,7 +431,7 @@ int surface_colour(struct surface *s, const uint8_t *per_strip, size_t n)
 		n = s->g.strips;
 	if (n)
 		memcpy(s->colour, per_strip, n);
-	s->ncolour = n;
+	s->ncolour = n ? n - 1 : 0;
 	if (!s->ops.colour || !s->online)
 		return 0;
 	return s->ops.colour(s->backend, s->colour, s->ncolour);
